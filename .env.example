# Placeholders only. Never put a real credential in this file.
# Development uses Plaid Sandbox exclusively. Production secrets live in
# systemd encrypted credentials on the VPS and are never present in this repo,
# in CI, or in any Claude Code session. See docs/security-model.md.

# --- Environment ---------------------------------------------------------
FINANCE_ENV=development            # development | test | staging | production

# --- PostgreSQL ----------------------------------------------------------
# Dev container credentials only. Production uses per-role credentials
# delivered as systemd credentials, not this variable.
#
# Least-privilege roles (docs/database.md, docs/security-model.md §5):
#   finance_migrator  DDL + creates the other roles; runs migrations only
#   finance_app       deterministic application writes (this variable)
#   finance_agent     reads plaid.*; writes only user.*/finance.*/agent.*
#   finance_observer  read-only ops.* for `finops`
#   finance_backup    read-only everywhere, for pg_dump
# All share the `devpassword` dev-container default unless a
# `<ROLE>_DB_PASSWORD` env var overrides it. Production passwords are
# provisioned out of band and never appear in this repository.
DATABASE_URL=postgresql+psycopg://finance_app:devpassword@localhost:5433/finance_dev
# Migrations run DDL and create roles, so they use finance_migrator.
ALEMBIC_DATABASE_URL=postgresql+psycopg://finance_migrator:devpassword@localhost:5433/finance_dev
# The runtime agent's own least-privilege connection (read plaid.*, write
# only user.*/finance.*/agent.*). Never point this at finance_app/finance_owner.
AGENT_DATABASE_URL=postgresql+psycopg://finance_agent:devpassword@localhost:5433/finance_dev
# `finops`'s own connection: strictly read-only (handoff §10, docs/security-model.md).
OBSERVER_DATABASE_URL=postgresql+psycopg://finance_observer:devpassword@localhost:5433/finance_dev
# pg_dump's connection for backups (deploy/scripts/backup.sh, ADR-015).
BACKUP_DATABASE_URL=postgresql+psycopg://finance_backup:devpassword@localhost:5433/finance_dev

# --- Plaid (SANDBOX ONLY in development) ---------------------------------
PLAID_ENV=sandbox                  # sandbox | production
PLAID_CLIENT_ID=replace-with-sandbox-client-id
PLAID_SECRET=replace-with-sandbox-secret
# Obtained via the one-time Link flow; see docs/runbooks/plaid-link.md
PLAID_ACCESS_TOKEN=
# Shared secret used to verify inbound webhooks (Milestone 8)
PLAID_WEBHOOK_SECRET=

# --- Runtime financial agent (provider-interchangeable, ADR-014) ---------
# Unrelated to the Claude Code engineering agent even when AGENT_PROVIDER
# is "anthropic" — see CLAUDE.md, ADR-013, ADR-014.
AGENT_PROVIDER=openai              # openai | anthropic — only the active one's key is required
OPENAI_API_KEY=replace-with-dev-key
OPENAI_MODEL=
ANTHROPIC_API_KEY=replace-with-dev-key
ANTHROPIC_MODEL=

# --- Backups (Milestone 7, ADR-015) ---------------------------------------
# Symmetric GPG passphrase encrypting backup archives before they leave the
# VPS. Production value is a systemd encrypted credential — never a real
# passphrase here. See docs/backups.md.
BACKUP_ENCRYPTION_KEY=replace-with-dev-only-passphrase
# Where deploy/scripts/backup.sh stages encrypted archives. A host-mounted
# volume in production; off-machine transfer of this directory's contents
# is a separate owner-performed step (docs/backups.md).
BACKUP_DIR=./backups

# --- Release identity (Milestone 7, ADR-008) ------------------------------
# Set by deploy/compose.yaml from the deployed image tag. Empty in
# development — `finops version` falls back to the package version.
RELEASE_ID=
# ghcr.io/<owner>/<repo> — where CI publishes images tagged by Git SHA.
CONTAINER_IMAGE_REPO=ghcr.io/jq712/claude-finance-app

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
