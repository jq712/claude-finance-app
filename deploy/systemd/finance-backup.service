[Unit]
Description=finance-app: encrypted PostgreSQL backup (handoff §22, ADR-015)
Documentation=https://github.com/jq712/claude-finance-app/blob/main/docs/backups.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/finance-app

LoadCredentialEncrypted=finance_backup_db_password:/etc/finance-app/credentials/finance_backup_db_password.cred
LoadCredentialEncrypted=finance_app_db_password:/etc/finance-app/credentials/finance_app_db_password.cred
LoadCredentialEncrypted=finance_migrator_db_password:/etc/finance-app/credentials/finance_migrator_db_password.cred
LoadCredentialEncrypted=finance_agent_db_password:/etc/finance-app/credentials/finance_agent_db_password.cred
LoadCredentialEncrypted=finance_observer_db_password:/etc/finance-app/credentials/finance_observer_db_password.cred
LoadCredentialEncrypted=backup_encryption_key:/etc/finance-app/credentials/backup_encryption_key.cred
EnvironmentFile=-/etc/finance-app/env

Environment=COMPOSE_FILE=/opt/finance-app/deploy/compose.yaml
ExecStart=/opt/finance-app/deploy/scripts/with-production-env.sh /opt/finance-app/deploy/scripts/backup.sh

TimeoutStartSec=600
