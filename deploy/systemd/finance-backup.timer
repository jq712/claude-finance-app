[Unit]
Description=Daily encrypted PostgreSQL backup (ADR-015)

[Timer]
# Before the daily sync so a same-day restore-worst-case never loses more
# than a day either way; staggered from finance-sync.timer so they don't
# contend for the database at the same moment.
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
