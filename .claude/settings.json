{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run alembic upgrade:*)",
      "Bash(uv run alembic revision:*)",
      "Bash(uv run alembic current:*)",
      "Bash(uv run alembic history:*)",
      "Bash(docker compose -f deploy/compose.dev.yaml:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)"
    ],
    "deny": [
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(//etc/finance/**)",
      "Read(//etc/finance-app/**)",
      "Read(//etc/credstore*/**)",
      "Read(~/.plaid/**)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(systemd-creds:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(docker compose -f deploy/compose.yaml:*)",
      "Bash(deploy/scripts/finops.sh:*)",
      "Bash(deploy/scripts/with-production-env.sh:*)",
      "Bash(alembic downgrade:*)",
      "Bash(uv run alembic downgrade:*)",
      "Bash(gh pr merge:*)",
      "Bash(dropdb:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-applied-migrations.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/python-checks.sh"
          }
        ]
      }
    ]
  }
}
