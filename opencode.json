{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "systemd-creds *": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*secrets/*": "deny",
      "*.env*": "ask",
      "git commit*": "ask",
      ".opencode/scripts/commit.sh *": "allow",
      "git push*": "ask",
      "gh pr merge*": "ask",
      "psql*": "ask",
      "dropdb*": "ask",
      "uv run alembic downgrade*": "ask",
      "alembic downgrade*": "ask",
      "deploy/scripts/finops.sh*": "ask",
      "deploy/scripts/with-production-env.sh*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  },
  "agent": {
    "plan": { "model": "deepseek/deepseek-v4-pro" },
    "build": { "model": "deepseek/deepseek-v4-flash" }
  }
}
